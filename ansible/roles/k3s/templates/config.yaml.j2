# {{ ansible_managed }}
# 이 파일이 정본이다. K3s 설치 스크립트를 CLI 플래그로 재실행하지 않는다.
# docs/architecture/overview.md의 K3s 표준 참조.

data-dir: "{{ k3s_data_dir }}"
secrets-encryption: true
default-local-storage-path: "{{ application_data_dir }}"

tls-san:
{% for ip in k3s_node_ips %}
  - {{ ip }}
{% endfor %}

node-name: "{{ inventory_hostname }}"
node-ip: "{{ private_ip }}"
advertise-address: "{{ private_ip }}"

cluster-cidr: "{{ cluster_cidr }}"
service-cidr: "{{ service_cidr }}"

# Cilium 을 위해 K3s 기본 CNI 와 NetworkPolicy 컨트롤러를 비활성화한다.
flannel-backend: none
disable-network-policy: true

disable:
  - traefik      # Argo CD가 Helm으로 관리한다
  - servicelb    # 가비아 External LB 와 역할 중복

etcd-snapshot-schedule-cron: "0 */6 * * *"
etcd-snapshot-retention: {{ k3s_etcd_s3_retention }}
etcd-s3: true
etcd-s3-endpoint: "{{ k3s_etcd_s3_endpoint }}"
etcd-s3-access-key: "{{ k3s_etcd_s3_access_key }}"
etcd-s3-secret-key: "{{ k3s_etcd_s3_secret_key }}"
etcd-s3-bucket: "{{ k3s_etcd_s3_bucket }}"
etcd-s3-region: "{{ k3s_etcd_s3_region }}"
etcd-s3-folder: "{{ k3s_etcd_s3_folder }}"
etcd-s3-bucket-lookup-type: path
etcd-s3-retention: {{ k3s_etcd_s3_retention }}

kubelet-arg:
  - "system-reserved=cpu=200m,memory=1Gi"
  - "kube-reserved=cpu=200m,memory=512Mi"
  - "eviction-hard=memory.available<300Mi,nodefs.available<10%,nodefs.inodesFree<5%,imagefs.available<15%,imagefs.inodesFree<5%"
  - "image-gc-high-threshold=75"
  - "image-gc-low-threshold=60"

kube-apiserver-arg:
  - "audit-policy-file=/etc/rancher/k3s/audit-policy.yaml"
  - "audit-log-path=/var/log/k3s-audit.log"
  - "audit-log-maxage=7"
  - "audit-log-maxbackup=5"
  - "audit-log-maxsize=100"

write-kubeconfig-mode: "0600"

{% if inventory_hostname not in groups['k3s_first_server'] %}
server: "https://{{ hostvars[groups['k3s_first_server'][0]]['private_ip'] }}:6443"
token: "{{ k3s_token }}"
{% else %}
cluster-init: true
token: "{{ k3s_token }}"
{% endif %}
